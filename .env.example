# Server
PORT=3000

# Slack
SLACK_BOT_TOKEN=xoxb-***
SLACK_SIGNING_SECRET=***
SLACK_NOTIFICATION_CHANNEL_ID=C0123456789

# GitHub
GITHUB_WEBHOOK_SECRET=***

# Optional behavior
