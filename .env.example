# Server
PORT=3000

# Slack
SLACK_BOT_TOKEN=xoxb-***
SLACK_SIGNING_SECRET=***
SLACK_NOTIFICATION_CHANNEL_ID=C0123456789

# GitHub
GITHUB_WEBHOOK_SECRET=***

# Optional behavior
SLACK_MENTION_ON_FAILURE=true

# Socket Mode bot (app-socket.py)
SLACK_APP_TOKEN=xapp-***
CODEX_ACTION_FOLDER=/absolute/path/to/your/repo
CODEX_SESSION_SCOPE=channel
# Only required when CODEX_SESSION_SCOPE=global
CODEX_SESSION_ID=your-codex-session-id
CODEX_SANDBOX_MODE=read-only
CODEX_ACCEPT_REACTION=eyes
CODEX_CONTEXT_DB_PATH=slack-context.db
CODEX_CONTEXT_LIMIT=80
CODEX_CONTEXT_RETENTION_DAYS=14
CODEX_CATCHUP_DEFAULT_LIMIT=500
CODEX_CATCHUP_MAX_LIMIT=2000
LOG_LEVEL=INFO
CODEX_SKIP_GIT_REPO_CHECK=true
